# =====================================================================
# LlamaOrchestrator Git Ignore
# =====================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# C extensions
*.obj
*.o

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Environment Variables & Secrets
.env
.env.local
.env.*.local
*.local

# Unit test / coverage / cache
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
nosetests.xml
coverage.xml
*.cover
*.py,cover

# IDE and Editor files
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Dynamic Session Workspaces & Logs
workspaces/*/
!workspaces/.gitkeep
workspaces/*.png
workspaces/*.jpg
workspaces/*.jpeg
workspaces/*.zip
workspaces/verify_ui.py
*.log

# Ephemeral Agent Campaign Runs & Test Outputs
marketing_campaigns_*
archived_campaigns/
brainstorming_sessions/
cadence_plans/
eval_reports/
test_reports/
executive_briefings/
outreach_campaigns/
pilot_communications/
resilience/
voice_demonstrations/
evaluation/

# Node.js & NPM / NPX cache
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Playwright & Browser-Use Automation Artifacts
browser-use-user-data-dir*
playwright-report/
test-results/
.playwright/
*.tmp
*.temp

