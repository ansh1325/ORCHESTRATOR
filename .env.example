# LlamaOrchestrator - Meta Global AI Developer Hackathon Configuration

# Primary Fast Inference Provider
GROQ_API_KEY=your_groq_api_key_here

# Alternative Providers
FIREWORKS_API_KEY=your_fireworks_api_key_here
BASETEN_API_KEY=your_baseten_api_key_here
OPENAI_API_KEY=your_openai_or_custom_llama_endpoint_key_here
OPENAI_BASE_URL=https://api.groq.com/openai/v1

# Meta Llama Models
META_MODEL_ORCHESTRATOR=llama-3.1-70b-versatile
META_MODEL_WORKER=llama-3.1-8b-instant

# Execution Settings
MOCK_MODE=false
AUTO_APPROVE_RECOMMENDED=true
LOG_LEVEL=INFO

# Server Config
HOST=0.0.0.0
PORT=8000
